{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"]
  },
  "include": ["code/**/*.tsx", "types/**/*.d.ts"]
}
