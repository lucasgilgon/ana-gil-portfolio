// Cloudflare Pages (proyecto "anagil"): web estática en site/dist + función /api/notas con la base de datos D1.
{
  "name": "anagil",
  "pages_build_output_dir": "./site/dist",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "anagil-visitas", "database_id": "0a0f36b3-b2d4-434a-bc52-b3a9ed724347" }
  ]
}
