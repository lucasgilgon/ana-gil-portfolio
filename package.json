{
  "name": "ana-gil-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "framer:dry": "node scripts/push-to-framer.mjs",
    "framer:push": "node scripts/push-to-framer.mjs --apply",
    "build": "npm --prefix site run build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm --prefix site run typecheck",
    "dev:full": "wrangler pages dev site/dist --ip 0.0.0.0 --port 8788"
  },
  "dependencies": {
    "framer-api": "^5.1.0"
  },
  "devDependencies": {
    "turndown": "^7.2.4",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "^0.35.5"
    }
  }
}
